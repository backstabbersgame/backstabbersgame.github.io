      "title": "Goal",
      "item1": "Eliminate players and stay alive to earn coins.",
      "item2": "Collect 5 coins to become the new Sovereign."
    },
    "preparation": {
      "backgroundMobile": "gradient",
      "background": "transparent",
      "title": "Preparation",
      "item1": "Select the game level;",
      "item2": "Shuffle all cards to be used;",
      "item3": "Distribute *2* (two) cards to each player;",
      "item4": "Place one card in the graveyard;",
      "item5": "Place the remaining cards in the draw pile."
    },

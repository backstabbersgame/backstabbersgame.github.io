  "regrasOpcionais": {
    "title": "Optional rules",
    "subtitle": "These actions must be agreed upon between players before starting the game.",
    "sections": [{ "component": "Content", "visible": true }],
    "regrasGerais": {
      "title": "General Rules",
      "punicao": {
        "title": "Punishment",
        "item1": {
          "title": "",
          "steps": {
            "1": "The player caught breaking the rules must reveal one of their cards to all players at the table."
          }
        }
      },
      "imposicao": {
        "title": "Enforcement",
        "item1": {
          "title": "",
          "steps": {
            "1": "Reactive card actions are mandatory, all players must pay close attention to prerequisites; if caught failing to use the reaction, they lose the reactive card."
          }
        }
      },
      "revanche": {
        "title": "Revenge",
        "item1": {
          "title": "",
          "steps": {
            "1": "When eliminated, the player must draw a card and place it in their Reserve. If they manage to eliminate a player, they return to the game with the card that was in their Reserve."
          }
        }
      }
    },
    "regrasCartas": {
      "title": "Card Rules",
      "sections": [{ "component": "Content", "visible": true }],
      "item1": {
        "imageSrc": "/images/chars/anj.svg",
        "imageAlt": "Angel character",
        "title": "Counterspell",
        "subtitle": "Angel",
        "steps": {
          "1": "If you choose the player who has Sacrifice in their Field, that player must take a card from the graveyard. If they already have the hand limit, this card goes to their Reserve."
        }
      },
      "item2": {
        "imageSrc": "/images/chars/pol.svg",
        "imageAlt": "Politician character",
        "title": "Elections",
        "subtitle": "Politician",
        "steps": {
          "1": "Occurs when both Politicians are in different players' Fields.",
          "2": "All players who don't have Politician and are not protected must give one card from their hand to the Politician they choose to vote for.",
          "3": "The Politician who receives the most votes (cards) takes both Politician cards to their Field.",
          "4": "The winning politician must, without looking, shuffle the received cards and then return them to their voters.",
          "5": "If a Politician is moved to another Field, elections are held again."
        }
      },
      "item3": {
        "imageSrc": "/images/chars/ref.svg",
        "imageAlt": "Reflection character",
        "title": "Reflect",
        "subtitle": "Reflection",
        "steps": {
          "1": "Reflection can be used to reverse the direction as soon as the Law of Return card is played. It can be used by any player, regardless of turn."
        }
      },
      "item4": {
        "imageSrc": "/images/chars/ref.svg",
        "imageAlt": "Reflection character",
        "title": "Ricochet",
        "subtitle": "Reflection",
        "steps": {
          "1": "If a player has Reflection during the Shooter's action.",
          "2": "The player with Reflection must choose a new number and the Shooter player becomes the target of the action.",
          "3": "The action ends with whoever played Reflection, who doesn't count as a target. Can be reflected again."
        }
      },
      "item5": {
        "imageSrc": "/images/chars/fof.svg",
        "imageAlt": "Gossiper character",
        "title": "Gossip wheel",
        "subtitle": "Gossiper",
        "steps": {
          "1": "If the Gossiper is reflected, all players must tell the sum of their cards only to the next player, in the current game order.",
          "2": "No defense or reaction should be considered in this action."
        }
      },
      "item6": {
        "imageSrc": "/images/chars/neg.svg",
        "imageAlt": "Merchant character",
        "title": "Exchange rate",
        "subtitle": "Merchant",
        "steps": {
          "1": "The player can choose to make an exchange between a player who has cards and one who doesn't.",
          "2": "This way, the eliminated player returns to the game.",
          "3": "If the target who had cards only had one card, they are eliminated, but the player who used the Merchant doesn't gain coins, as they only swapped one eliminated player for another."
        }
      }
    }
  }

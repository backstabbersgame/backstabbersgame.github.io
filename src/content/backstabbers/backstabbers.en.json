        "title": "Reserve",
        "subtitle": "During the player's turn, if there is a card in Reserve, they must draw it instead of taking from the Draw Pile."
      },
      "item5": {
        "title": "Leader",
        "subtitle": "Card chosen to perform actions and represent the player during the next round."
      },

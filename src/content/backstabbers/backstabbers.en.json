    "generalRules": {
      "backgroundMobile": "gray",
      "background": "transparent",
      "title": "General rules",
      "item1": {
        "title": "On your turn, you must perform the following actions in this order:",
        "steps": {
          "1": "1. Draw a card;",
          "2": "2. Move your current Leader to Discard or Permanent Area;",
          "3": "3. Choose an action from one of the cards in your hand;",
          "4": "4. Perform your action by placing the chosen card as your Leader."
        }
      },
      "item2": "After your turn, the game proceeds to the next player, clockwise. Turns continue until only one player with cards in hand remains.",
      "item3": "A player is eliminated when they lose all cards from their hand. The player who eliminates an opponent receives a coin.",
      "item4": "Sharing information acquired with other players is not allowed.",
      "item5": "If a player is caught lying, they are immediately eliminated from the round."
    },
    "endGame": {
      "backgroundMobile": "white",
      "background": "transparent",
      "title": "End of game",
      "item1": "The last player who has cards in hand wins two coins.",
      "item2": "If, at this moment, any player has *5 coins* or more, the player with the most coins becomes the new Sovereign and the game ends.",
      "item3": "Otherwise, a new match begins, starting with the player who won the previous round."
    },
